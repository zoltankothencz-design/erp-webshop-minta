# Másold .env néven, és töltsd ki. A .env SOHA nem kerül gitbe.

APP_URL=http://127.0.0.1:8080

# Adatbázis (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=webshop_minta
DB_USER=root
DB_PASS=

# Admin felület: a `console seed` ezt a felhasználót hozza létre (helyi fejlesztéshez való példa-érték)
ADMIN_USER=admin
ADMIN_PASSWORD=valtoztasd-meg-hosszu-jelszora

# --- Külső rendszerek: alapból a helyi szimulált szerverre (mock) mutatnak ---
# ERP (saját belső rendszer)
ERP_BASE_URL=http://127.0.0.1:8081/erp
ERP_API_KEY=demo-erp-key

# Marketplace
MARKETPLACE_BASE_URL=http://127.0.0.1:8081/marketplace
MARKETPLACE_API_KEY=demo-marketplace-key

# Google Ads. Éles használatnál: https://googleads.googleapis.com/vXX és https://oauth2.googleapis.com/token
# (az aktuális API-verziót a Google dokumentációjából kell ellenőrizni)
ADS_BASE_URL=http://127.0.0.1:8081/ads/v17
ADS_OAUTH_TOKEN_URL=http://127.0.0.1:8081/ads/oauth/token
ADS_CUSTOMER_ID=1234567890
ADS_LOGIN_CUSTOMER_ID=
ADS_DEVELOPER_TOKEN=demo-dev-token
ADS_CLIENT_ID=demo-client-id
ADS_CLIENT_SECRET=demo-client-secret
ADS_REFRESH_TOKEN=demo-refresh-token
ADS_CONVERSION_ACTION_ID=987654321

# AI: "mock" (kulcs nélkül, helyi szövegsablon) vagy "claude" (valódi API, ANTHROPIC_API_KEY kell)
AI_DRIVER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5-5
